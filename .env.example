# ==============================================================================
# PROMPT PETTI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Django Secret Key (generate a secure random 50+ character string in production)
SECRET_KEY=django-insecure-your-secret-key-change-this-in-production

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated list, e.g. promptpetti.com,promptpetti.up.railway.app,localhost)
ALLOWED_HOSTS=*,localhost,127.0.0.1

# Database Configuration:
# - Leave commented out or empty to use local SQLite (default)
# - For PostgreSQL on Render/Railway/Supabase, set DATABASE_URL:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Timezone (defaults to Asia/Kolkata for 6:00 PM IST drops)
TIME_ZONE=Asia/Kolkata
